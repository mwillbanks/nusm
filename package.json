{
  "dependencies": {
    "@fastify/deepmerge": "^3.2.4",
    "@tanstack/devtools-event-client": "^0.5.1",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/store": "^0.11.2",
    "fast-equals": "^6.2.2",
    "superjson": "^2.2.6",
    "use-sync-external-store": "^1.7.0"
  },
  "description": "Non Uniform State Manager nusm (pronounced \"noose em\") built on @tanstack/store with optional persisted adapters.",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tanstack/devtools": "^0.16.0",
    "@tanstack/devtools-utils": "^0.7.2",
    "@tanstack/intent": "0.5.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "fake-indexeddb": "^6.2.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "lucide-react": "^1.73.0",
    "oxc-parser": "^0.159.0",
    "oxc-transform": "^0.159.0",
    "oxlint": "^1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "!docs/AGENT-SKILL.md",
    "!docs/RELEASING.md",
    "skills/nusm"
  ],
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "bun fmt",
      "oxlint --deny-warnings --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": [
      "bun fmt"
    ]
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "name": "nusm",
  "overrides": {
    "ajv": "8.20.0",
    "basic-ftp": "6.2.6",
    "defu": "6.1.7",
    "fast-uri": "4.2.3",
    "handlebars": "4.7.10",
    "ip-address": "10.7.6",
    "js-yaml": "5.5.0",
    "picomatch": "4.0.7",
    "seroval": "1.8.1",
    "seroval-plugins": "1.8.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@tanstack/devtools": "^0.12.5 || ^0.13.0 || ^0.14.0 || ^0.15.0 || ^0.16.0",
    "@tanstack/devtools-utils": "^0.6.0 || ^0.7.0",
    "lucide-react": ">=0.468.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@tanstack/devtools": {
      "optional": true
    },
    "@tanstack/devtools-utils": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mwillbanks/nusm.git"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "example:build": "bun run --cwd example build",
    "example:devtools": "bun run build && bun run --cwd example dev",
    "example:serve": "bun run --cwd example serve",
    "example:test": "bun run --cwd example test",
    "example:typecheck": "bun run --cwd example typecheck",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "intent:check": "intent maintainer check",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "pack:check": "bun scripts/check-packed-consumer.ts",
    "prepack": "bun run build",
    "prepare": "./node_modules/.bin/husky",
    "skill:lint": "vale --no-global skills/nusm",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:workspace": "bun test",
    "typecheck": "bun check -p tsconfig.build.json && bun check --types bun scripts"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.2.0"
}
