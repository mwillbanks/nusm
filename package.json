{
  "dependencies": {
    "@fastify/deepmerge": "^3.2.1",
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/store": "^0.11.0",
    "fast-equals": "^6.0.2",
    "superjson": "^2.2.6"
  },
  "description": "Non Uniform State Manager nusm (pronounced \"noose em\") built on @tanstack/store with optional persisted adapters.",
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@happy-dom/global-registrator": "^20.10.6",
    "@release-it/conventional-changelog": "^11.0.1",
    "@tanstack/devtools": "^0.12.5",
    "@tanstack/devtools-utils": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "release-it": "^20.2.1",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./devtools": {
      "default": "./dist/devtools/index.js",
      "types": "./dist/devtools/index.d.ts"
    },
    "./react": {
      "default": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "lint-staged": {
    "*": [
      "bunx --bun biome lint --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "name": "nusm",
  "overrides": {
    "ajv": "8.20.0",
    "basic-ftp": "6.0.1",
    "defu": "6.1.7",
    "fast-uri": "4.1.0",
    "handlebars": "4.7.9",
    "ip-address": "10.1.1",
    "js-yaml": "4.2.0",
    "picomatch": "4.0.5"
  },
  "peerDependencies": {
    "@tanstack/devtools": "^0.12.5",
    "@tanstack/devtools-utils": "^0.6.0",
    "lucide-react": ">=0.468.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@tanstack/devtools": {
      "optional": true
    },
    "@tanstack/devtools-utils": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "pushRepo": "origin",
      "requireBranch": "main",
      "requireCommits": true
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "header": "# Changelog",
        "infile": "CHANGELOG.md",
        "preset": "angular"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example:build": "bun run --cwd example build",
    "example:devtools": "bun run build && bun run --cwd example dev",
    "example:serve": "bun run --cwd example serve",
    "example:test": "bun run --cwd example test",
    "prepare": "./node_modules/.bin/husky",
    "test": "bun test",
    "test:workspace": "bun test"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.1.0"
}
