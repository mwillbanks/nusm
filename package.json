{
  "dependencies": {
    "@fastify/deepmerge": "^3.2.2",
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/store": "^0.11.2",
    "fast-equals": "^6.1.0",
    "superjson": "^2.2.6",
    "use-sync-external-store": "^1.7.0"
  },
  "description": "Non Uniform State Manager nusm (pronounced \"noose em\") built on @tanstack/store with optional persisted adapters.",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@bun-security-scanner/osv": "^1.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tanstack/devtools": "^0.15.0",
    "@tanstack/devtools-utils": "^0.7.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/use-sync-external-store": "^1.7.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.53.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "release-it": "^21.1.1",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./devtools": {
      "default": "./dist/devtools/index.js",
      "types": "./dist/devtools/index.d.ts"
    },
    "./react": {
      "default": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --deny-warnings --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "name": "nusm",
  "overrides": {
    "ajv": "8.20.0",
    "basic-ftp": "6.2.2",
    "defu": "6.1.7",
    "fast-uri": "4.2.1",
    "handlebars": "4.7.10",
    "ip-address": "10.7.3",
    "js-yaml": "5.4.3",
    "picomatch": "4.0.7"
  },
  "peerDependencies": {
    "@tanstack/devtools": "^0.12.5 || ^0.13.0 || ^0.14.0 || ^0.15.0",
    "@tanstack/devtools-utils": "^0.6.0 || ^0.7.0",
    "lucide-react": ">=0.468.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@tanstack/devtools": {
      "optional": true
    },
    "@tanstack/devtools-utils": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "pushRepo": "origin",
      "requireBranch": "main",
      "requireCommits": true
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "header": "# Changelog",
        "infile": "CHANGELOG.md",
        "preset": "angular"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example:build": "bun run --cwd example build",
    "example:devtools": "bun run build && bun run --cwd example dev",
    "example:serve": "bun run --cwd example serve",
    "example:test": "bun run --cwd example test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "prepare": "./node_modules/.bin/husky",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:workspace": "bun test",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "1.2.0"
}
